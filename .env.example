# Host Server
HOA_BIND_HOST=0.0.0.0
HOA_BIND_PORT=8000
HOA_API_KEY=replace-with-a-long-random-api-key
# none: LAN users can operate without entering a key; api_key: require X-API-Key
HOA_AUTH_MODE=api_key
HOA_NODE_TOKENS=pi-lab:replace-with-a-long-random-node-token
HOA_DB_PATH=./data/hand_of_agents.db
HOA_CORS_ORIGINS=http://localhost:8000,http://192.168.1.40:8000
HOA_COMMAND_TIMEOUT=5
