[Unit]
Description=Hand of Agents Raspberry Pi GPIO Client
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=genius
Group=genius
SupplementaryGroups=gpio
RuntimeDirectory=hand-of-agents
RuntimeDirectoryMode=0750
WorkingDirectory=/run/hand-of-agents
ExecStart=/opt/hand-of-agents/.venv/bin/hoa-client --config /etc/hand-of-agents/client.toml
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
DeviceAllow=/dev/gpiochip0 rw
DeviceAllow=/dev/gpiomem rw

[Install]
WantedBy=multi-user.target
